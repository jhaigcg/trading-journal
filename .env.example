# Pooled connection (Neon: use the "pooled" host) — used by the running app
DATABASE_URL="postgresql://journal:journal@localhost:5432/journal"
# Direct connection (Neon: the non-pooled host) — used by prisma migrate
DIRECT_URL="postgresql://journal:journal@localhost:5432/journal"
# 32+ random chars: openssl rand -hex 32
AUTH_SECRET=""
# Used only by the seed script to create your login
SEED_EMAIL="you@example.com"
SEED_PASSWORD=""
# MetaApi (metaapi.cloud) API token — enables the MT4 auto-sync. Region matches your MetaApi account (new-york | london | singapore)
METAAPI_TOKEN=""
METAAPI_REGION="new-york"
# Random string; Vercel Cron sends it as a bearer token to /api/cron/sync
CRON_SECRET=""
# Screenshots: leave empty in development (saved under ./.data/uploads). In production create a Vercel Blob store and paste its token.
BLOB_READ_WRITE_TOKEN=""
# Only if your network needs a proxy to reach the internet (price charts download from Dukascopy), e.g. http://127.0.0.1:7890
# HTTPS_PROXY=""
